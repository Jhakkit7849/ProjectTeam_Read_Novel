# ========================
# Root level (my-app/.gitignore)
# ========================

# Node modules for both frontend and backend
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# dotenv environment variables
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Vite cache
.vite/

# IDE/editor configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db

# ========================
# Optionally, ignore client and server node_modules individually:
# ========================

client/node_modules/
server/node_modules/

# ========================
# Optionally, ignore build folders if separated
# ========================

client/dist/
server/dist/
